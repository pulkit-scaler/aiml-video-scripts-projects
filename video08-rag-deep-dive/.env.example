# Copy to .env in this folder and fill in. Never commit .env.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b (its own free-tier budget, separate from Videos 1 and 10).
MODEL=
# Optional. Local embedding model, no key needed. Default: BAAI/bge-base-en-v1.5
EMBED_MODEL=
# on (default) = replay saved answers on camera; off = always call the model live.
DEMO_CACHE=on
