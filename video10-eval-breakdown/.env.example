# Copy to .env in this folder and fill in. Never commit .env.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-20b. Must support strict JSON schema on Groq
# (openai/gpt-oss-20b or openai/gpt-oss-120b).
MODEL=
# on (default) = replay saved answers on camera; off = always call the model live.
DEMO_CACHE=on
